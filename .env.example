# Copy to .env.local for local development and replace the placeholders.
# Production uses a server-only .env.production (mode 600) — never commit or rsync it.

# --- App ---
# Production: https://slotwell.app
APP_URL=http://localhost:3004
# Public booking links look like APP_URL/OWNER_USERNAME/<event-slug>
OWNER_USERNAME=iamprashanta
OWNER_DISPLAY_NAME="Prashanta Mondal"
# Your own account: gets OWNER_USERNAME automatically on first sign-in (others pick one in /onboarding).
OWNER_EMAIL=you@example.com
# Admin panel (/admin): these accounts get the admin role (comma-separated). Defaults to OWNER_EMAIL.
ADMIN_EMAILS=you@example.com
# Set to false to stop new sign-ups (ADMIN_EMAILS can still sign up).
SIGNUPS_OPEN=true
OWNER_TIME_ZONE=Asia/Kolkata
# Origins allowed to embed /embed/* pages (comma-separated).
EMBED_ALLOWED_ORIGINS=https://prashanta.dev,http://localhost:3000

# --- Podman port binding (keep 127.0.0.1; see compose.yml for Windows/WSL networking) ---
HOST_BIND=127.0.0.1

# --- Database (local Podman service listens on 5433 to avoid the invoice app's 5432) ---
DB_NAME=slotwell
DB_USER=slotwell_user
DB_PASSWORD=replace-with-local-password
DATABASE_URL="postgresql://slotwell_user:replace-with-local-password@localhost:5433/slotwell"

# --- Auth (Better Auth) ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3004

# --- Local demo (never enable on a public server) ---
# CALENDAR_PROVIDER=none skips Google Calendar entirely; DEV_PASSWORD_LOGIN allows email + password sign-in.
CALENDAR_PROVIDER=none
DEV_PASSWORD_LOGIN=true
DEV_OWNER_PASSWORD=choose-a-local-password

# --- Google OAuth (Google Cloud Console → Credentials → OAuth client ID, type "Web application") ---
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (local Mailpit on 1026 / UI on http://localhost:18026) ---
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_FROM="Slotwell <bookings@localhost.test>"
# Production: real SMTP credentials and a verified sender on your domain.
# SMTP_USER=
# SMTP_PASSWORD=
